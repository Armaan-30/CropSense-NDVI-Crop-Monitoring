{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    /* Emit is handled by Vite; tsc only type-checks. */
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,

    /* Strictness. Every one of these has caught a real bug at some point;
       none is decorative. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noImplicitOverride": true,
    /* API responses are parsed JSON, so indexed access genuinely can be
       undefined. Making that explicit prevents silent NaN in the charts. */
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    /* `paths` without `baseUrl`: TypeScript 6 deprecated `baseUrl` and resolves
       these patterns relative to this file instead. The same alias is declared
       for the bundler in vite.config.ts. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
