###############################################################################
# CropSense frontend configuration
#
# Copy to `.env.local` (git-ignored) and adjust as needed:
#     cp .env.example .env.local
#
# Only variables prefixed with VITE_ are exposed to the browser. Anything you
# put here is PUBLIC once the app is built - never place a secret in this file.
# Earth Engine credentials live on the backend only; the browser receives
# short-lived signed tile URLs that carry no credential.
###############################################################################

# Base URL of the CropSense FastAPI backend.
#
# Leave EMPTY in development: Vite proxies /api and /health to the backend
# (see vite.config.ts), so the browser stays on one origin and CORS is not
# involved.
#
# Set it for production builds, e.g. https://api.cropsense.example.com
# The backend's CORS_ORIGINS must then include the origin serving this app.
VITE_API_BASE_URL=

# Override the dev-server proxy target if your backend is not on port 8000.
# Read by vite.config.ts at startup, not by the browser.
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Initial map view. Defaults show Maharashtra; adjust for your fields.
VITE_DEFAULT_MAP_CENTER_LAT=19.7515
VITE_DEFAULT_MAP_CENTER_LNG=75.7139
VITE_DEFAULT_MAP_ZOOM=7

# Request timeout in milliseconds. Earth Engine analyses of large AOIs or long
# date ranges legitimately take tens of seconds, so keep this generous.
VITE_REQUEST_TIMEOUT_MS=120000
