###############################################################################
# CropSense configuration
#
# Copy this file to `.env` in the repository root and fill in the values.
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials.
###############################################################################

# =============================================================================
# GOOGLE EARTH ENGINE  (required - the app cannot analyse anything without this)
# =============================================================================

# The Google Cloud project registered for Earth Engine use.
# REQUIRED. The Earth Engine v1 API refuses to initialise without a project.
#
# How to get one:
#   1. Create or pick a Google Cloud project: https://console.cloud.google.com/
#   2. Enable the Earth Engine API:
#      https://console.cloud.google.com/apis/library/earthengine.googleapis.com
#   3. Register the project for Earth Engine (free for noncommercial /
#      research use): https://code.earthengine.google.com/register
EE_PROJECT=your-gcp-project-id

# -----------------------------------------------------------------------------
# Authentication - pick ONE of the two options below.
# -----------------------------------------------------------------------------

# OPTION A (easiest for local development): user credentials.
# Run this once in the backend virtual environment:
#     earthengine authenticate
# It opens a browser, then writes a token to
#     ~/.config/earthengine/credentials       (macOS/Linux)
#     %USERPROFILE%\.config\earthengine\credentials   (Windows)
# Leave this true and leave the service-account variables blank.
EE_USE_LOCAL_CREDENTIALS=true

# OPTION B (required for servers, Docker and CI): a service account.
#   1. Create a service account in your GCP project.
#   2. Grant it the "Earth Engine Resource Viewer" role.
#   3. Register the service-account EMAIL for Earth Engine at
#      https://code.earthengine.google.com/register (it needs its own
#      registration - project registration is not enough).
#   4. Create and download a JSON key.
#   5. Set the email plus EITHER the key file path OR the inline JSON below,
#      and set EE_USE_LOCAL_CREDENTIALS=false.
#
# EE_SERVICE_ACCOUNT_EMAIL=cropsense-ee@your-gcp-project-id.iam.gserviceaccount.com
# EE_SERVICE_ACCOUNT_KEY_FILE=./secrets/cropsense-ee-key.json
#
# Or supply the key inline as one line of JSON (useful with a secret manager or
# a container platform's env vars). Takes precedence over the key file.
# EE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# Use Earth Engine's high-volume endpoint. Recommended: it is tuned for many
# small interactive requests, which is exactly CropSense's access pattern.
EE_USE_HIGH_VOLUME_ENDPOINT=true

# Abort start-up if Earth Engine cannot initialise.
# false (development): the API still boots and GET /health explains what is
#                     missing.
# true  (production):  refuse to serve traffic while misconfigured.
EE_FAIL_FAST=false


# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=CropSense API
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api

# Comma-separated browser origins allowed to call the API.
# 5173 is the Vite dev server default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local SQLite history database. The file is ignored by Git; Docker uses a
# named volume mounted at /data.
DATABASE_PATH=./data/cropsense.sqlite3


# =============================================================================
# SENTINEL-2 / EARTH ENGINE DATA
# =============================================================================

# Sentinel-2 Level-2A surface reflectance, harmonised across the
# processing-baseline 04.00 radiometric offset change.
S2_COLLECTION_ID=COPERNICUS/S2_SR_HARMONIZED

# Cloud Score+ (recommended cloud/shadow assessment for Sentinel-2).
CLOUD_SCORE_PLUS_COLLECTION_ID=GOOGLE/CLOUD_SCORE_PLUS/V1/S2_HARMONIZED
CLOUD_SCORE_PLUS_BAND=cs_cdf
# Keep pixels with clearness at or above this value. Raise toward 0.8 for
# stricter masking (fewer usable pixels), lower toward 0.4 to keep more.
CLOUD_SCORE_PLUS_THRESHOLD=0.60

# Band names in the Sentinel-2 SR product.
BAND_RED=B4
BAND_NIR=B8
BAND_SCL=SCL
BAND_QA60=QA60

# Surface reflectance is stored as scaled integers (DN = reflectance x 10000).
REFLECTANCE_SCALE=0.0001

# Analysis scale in metres. 10 m is Sentinel-2 native for B4/B8. Increase for
# large AOIs to trade spatial detail for speed.
DEFAULT_ANALYSIS_SCALE_M=10

# Request guard rails.
MAX_AOI_AREA_KM2=2500
MAX_DATE_RANGE_DAYS=730
MAX_TIMESERIES_POINTS=200
REDUCE_REGION_MAX_PIXELS=10000000


# =============================================================================
# NDVI HEALTH CLASSIFICATION
# =============================================================================
#
# !! IMPORTANT - THESE ARE NOT UNIVERSAL THRESHOLDS !!
#
# Four ascending NDVI boundaries defining five classes:
#   very_low     : NDVI <  0.2   (bare soil, water, built-up, senesced residue)
#   low          : 0.2 - 0.4
#   moderate     : 0.4 - 0.6
#   healthy      : 0.6 - 0.8
#   very_healthy : NDVI >= 0.8
#
# The NDVI value that means "healthy" depends on crop type, growth stage,
# canopy architecture, soil background, region, season, sensor geometry and
# atmospheric conditions. A wheat field at tillering and the same field at
# booting have very different "healthy" NDVI. Calibrate these against ground
# observations for your own fields before using them operationally.
NDVI_CLASS_THRESHOLDS=0.2,0.4,0.6,0.8

# Minimum same-pixel NDVI drop between two periods that flags a POTENTIAL
# stress area. A screening threshold, not a diagnosis.
NDVI_DECLINE_THRESHOLD=0.15


# =============================================================================
# FRONTEND (used by Vite at build time; see frontend/.env.example)
# =============================================================================
# VITE_API_BASE_URL=http://localhost:8000
